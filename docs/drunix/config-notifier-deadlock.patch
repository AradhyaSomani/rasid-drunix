+SPDX-License-Identifier: Apache-2.0
+*/
+
+package commit
+
+import (
+	"testing"
+	"time"
+
+	cp "github.com/hyperledger/fabric-protos-go/common"
+	"github.com/hyperledger/fabric-protos-go/peer"
+	"github.com/npci/drunix/core/ledger"
+	"github.com/stretchr/testify/require"
+)
+
+func lifecycleBlock(number uint64, txIDs ...string) *ledger.CommitNotification {
+	block := &ledger.CommitNotification{BlockNumber: number}
+	for _, txID := range txIDs {
+		block.TxsInfo = append(block.TxsInfo, &ledger.CommitNotificationTxInfo{
+			TxType:         cp.HeaderType_ENDORSER_TRANSACTION,
+			TxID:           txID,
+			ValidationCode: peer.TxValidationCode_VALID,
+			ChaincodeID:    &peer.ChaincodeID{Name: "_lifecycle"},
+		})
+	}
+	return block
+}
+
+// A lite peer that restarts leaves its old config listener registered until the
+// next block. Two approvals in one block used to block the notifier on the
+// second send to that listener, and with it every later commit on the peer.
+func TestConfigNotifierSkipsListenersThatAreGone(t *testing.T) {
+	notifier := newStatusNotifier()
+
+	goneDone := make(chan struct{})
+	gone := notifier.registerConfigListener(goneDone, "peer0.org1.example.com")
+	liveDone := make(chan struct{})
+	defer close(liveDone)
+	live := notifier.registerConfigListener(liveDone, "peer0.org1.example.com")
+
+	received := make(chan *Status, 4)
+	go func() {
+		for event := range live {
+			received <- event
+		}
+	}()
+	// The old stream reads nothing more and ends.
+	close(goneDone)
+	_ = gone
+
+	finished := make(chan struct{})
+	go func() {
+		notifier.ReceiveBlock(lifecycleBlock(3, "approve-org1", "approve-org2"))
+		notifier.ReceiveBlock(lifecycleBlock(4, "commit"))
+		close(finished)
+	}()
+
+	select {
+	case <-finished:
+	case <-time.After(5 * time.Second):
+		t.Fatal("block notifier is stuck sending to a lite peer that has gone")
+	}
+	require.Len(t, received, 3, "the connected lite peer gets every config event")
+}
+
+// Registering a listener while a config block is being notified must not race.
+func TestConfigNotifierRegistersWhileNotifying(t *testing.T) {
+	notifier := newStatusNotifier()
+	done := make(chan struct{})
+	defer close(done)
+
+	registered := make(chan struct{})
+	go func() {
+		defer close(registered)
+		for i := 0; i < 100; i++ {
+			events := notifier.registerConfigListener(done, "peer0.org2.example.com")
+			go func() {
+				for range events {
+				}
+			}()
+		}
+	}()
+	for i := uint64(0); i < 100; i++ {
+		notifier.ReceiveBlock(lifecycleBlock(i, "tx"))
+	}
+	<-registered
+}
diff --git a/internal/pkg/gateway/commit/statusnotifier.go b/internal/pkg/gateway/commit/statusnotifier.go
index 12c8ca2..18ba9cc 100644
--- a/internal/pkg/gateway/commit/statusnotifier.go
+++ b/internal/pkg/gateway/commit/statusnotifier.go
@@ -172,3 +172,14 @@ func (listener *statusListener) close() {
 func (listener *statusListener) receive(event *Status) {
 	listener.notifyChannel <- event
 }
+
+// receiveUnlessDone delivers the event, or gives up once the listener is done.
+// It reports whether the event was delivered.
+func (listener *statusListener) receiveUnlessDone(event *Status) bool {
+	select {
+	case listener.notifyChannel <- event:
+		return true
+	case <-listener.done:
+		return false
+	}
+}
